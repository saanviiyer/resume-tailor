# Copy this file to .env and fill in what you need. The app has TWO independent
# zero-setup fallbacks, so it runs fully with none of these set:
#   - No ANTHROPIC_API_KEY  -> MOCK AI mode (realistic canned output)
#   - No Supabase vars      -> ANONYMOUS mode (no auth, no limits, no persistence)
# Set the Supabase vars to turn on accounts + cloud persistence + rate limiting.

# --- AI (server-side only; never shipped to the browser) -------------------
# If unset, the server runs in MOCK MODE (fully usable, no key needed).
ANTHROPIC_API_KEY=

# --- Supabase: client (public; safe to expose in the browser) --------------
# From your Supabase project: Settings -> API. Leave BOTH blank to run the app
# in anonymous/no-persistence mode (behaves like the original demo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase: server (SECRET; server-side only) ---------------------------
# The service-role key bypasses RLS and validates JWTs + reads/writes data.
# NEVER expose this to the browser. SUPABASE_URL is the same project URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Limits ----------------------------------------------------------------
# Free-tier daily AI generations per user (enforced only when Supabase is on).
# Set to 0 for unlimited.
FREE_DAILY_GENERATIONS=5

# Optional: override the server port (default 3001)
PORT=3001
